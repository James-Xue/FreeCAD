{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure (Debug)",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/tools/build/external_lowcpu.sh",
                "configure",
                "--build-root",
                "${workspaceFolder}/build",
                "--build-type",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake: Build (Debug)",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/tools/build/external_lowcpu.sh",
                "build",
                "--build-root",
                "${workspaceFolder}/build",
                "--build-type",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build"
            },
            "dependsOn": [
                "CMake: Configure (Debug)"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake: Configure (Release)",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/tools/build/external_lowcpu.sh",
                "configure",
                "--build-root",
                "${workspaceFolder}/build",
                "--build-type",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake: Build (Release)",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/tools/build/external_lowcpu.sh",
                "build",
                "--build-root",
                "${workspaceFolder}/build",
                "--build-type",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "CMake: Configure (Release)"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake: Build Only (Release)",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/tools/build/external_lowcpu.sh",
                "build",
                "--build-root",
                "${workspaceFolder}/build",
                "--build-type",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake: Build Only (Debug)",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/tools/build/external_lowcpu.sh",
                "build",
                "--build-root",
                "${workspaceFolder}/build",
                "--build-type",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}