{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Release FreeCAD (GUI)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/release/bin/FreeCAD",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/build/release/lib:${workspaceFolder}/build/release/bin:${env:LD_LIBRARY_PATH}"
                }
            ],
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: Build Only (Release)"
        },
